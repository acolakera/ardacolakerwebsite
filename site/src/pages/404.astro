---
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>404 — Arda Colaker</title>

  <meta
    name="description"
    content="Aradığınız sayfa bulunamadı."
  />

  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#070707" />

  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <header>
    <div class="container">

      <nav>
        <a href="/" class="logo">
          Arda Colaker
        </a>

        <div class="languages">
          <a href="/" class="active">TR</a>

          <span class="language-separator">
            /
          </span>

          <a href="/en/">
            EN
          </a>
        </div>
      </nav>

    </div>
  </header>


  <main id="main">

    <div class="container">

      <div class="hero">

        <div class="eyebrow">
          404 · Page not found
        </div>

        <h1>
          Kayıp<br />
          sayfa.
        </h1>

        <p class="hero-text">
          Aradığın sayfa taşınmış, silinmiş
          veya hiç var olmamış olabilir.
        </p>

        <div class="hero-actions">

          <a href="/" class="button">
            Ana sayfaya dön ←
          </a>

          <a href="/en/" class="button secondary">
            English
          </a>

        </div>

      </div>

    </div>

  </main>


  <footer>

    <div class="container footer-content">

      <span>
        © {year} Arda Colaker
      </span>

      <span>
        ardacolaker.com
      </span>

    </div>

  </footer>

</body>
</html>
