---
import { content } from "../data/content.js";

const { lang = "tr" } = Astro.props;

const t = content[lang];
const isTurkish = lang === "tr";

const currentUrl = isTurkish
  ? "https://ardacolaker.com/"
  : "https://ardacolaker.com/en/";

const homeUrl = isTurkish ? "/" : "/en/";
---

<!DOCTYPE html>
<html lang={t.lang}>

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Arda Colaker</title>

  <meta
    name="description"
    content={
      isTurkish
        ? "Arda Colaker'ın kişisel web sitesi, projeleri ve özgeçmişi."
        : "Arda Colaker's personal website, projects and CV."
    }
  />

  <meta name="theme-color" content="#010305" />

  <link rel="canonical" href={currentUrl} />

  <link
    rel="alternate"
    hreflang="tr"
    href="https://ardacolaker.com/"
  />

  <link
    rel="alternate"
    hreflang="en"
    href="https://ardacolaker.com/en/"
  />

  <link
    rel="alternate"
    hreflang="x-default"
    href="https://ardacolaker.com/"
  />

  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <a class="skip-link" href="#main">
    {isTurkish ? "İçeriğe geç" : "Skip to content"}
  </a>


  <!-- HEADER -->

  <header>

    <div class="container">

      <nav
        aria-label={
          isTurkish
            ? "Ana navigasyon"
            : "Main navigation"
        }
      >

        <a href={homeUrl} class="logo">
          Arda Colaker
        </a>


        <div class="nav-right">

          <div class="nav-links">

            <a href="#projects">
              {t.nav.projects}
            </a>

            <a href="#cv">
              {t.nav.cv}
            </a>

            <a href="#contact">
              {t.nav.contact}
            </a>

          </div>


          <div
            class="languages"
            aria-label={
              isTurkish
                ? "Dil seçimi"
                : "Language selector"
            }
          >

            <a
              href="/"
              class={isTurkish ? "active" : ""}
              aria-current={isTurkish ? "page" : undefined}
            >
              TR
            </a>

            <span class="language-separator">
              /
            </span>

            <a
              href="/en/"
              class={!isTurkish ? "active" : ""}
              aria-current={!isTurkish ? "page" : undefined}
            >
              EN
            </a>

          </div>

        </div>

      </nav>

    </div>

  </header>


  <!-- MAIN -->

  <main id="main">


    <!-- HERO -->

    <div class="container">

      <div class="hero">

        <div class="eyebrow">
          {t.hero.eyebrow}
        </div>


        <h1>
          Arda<br />
          Colaker.
        </h1>


        <div class="hero-actions">

          <a
            href="#projects"
            class="button"
          >
            {t.hero.projectsButton}
          </a>

          <a
            href="#cv"
            class="button secondary"
          >
            {isTurkish ? "CV'ye git ↓" : "View CV ↓"}
          </a>

        </div>


        <span class="scroll-hint">
          {t.hero.scroll}
        </span>

      </div>

    </div>


    <!-- PROJECTS -->

    <section id="projects">

      <div class="container">

        <div class="section-header">

          <div class="section-number">
            {t.projects.label}
          </div>

          <h2>
            {t.projects.title}
          </h2>

        </div>


        <div class="project-grid">

          {
            t.projects.items.map((project) => (

              <article class="project">

                <span class="project-label">
                  {project.label}
                </span>

                <div>

                  <h3>
                    {project.title}
                  </h3>

                </div>

              </article>

            ))
          }

        </div>

      </div>

    </section>


    <!-- CV -->

    <section id="cv">

      <div class="container">

        <div class="section-header">

          <div class="section-number">
            {t.cv.label}
          </div>

          <h2>
            {t.cv.title}
          </h2>

        </div>


        <div class="cv-action">

          <a
            href="/cv.pdf"
            download="Arda-Colaker-CV.pdf"
            class="button"
          >
            {t.cv.download}
          </a>

        </div>

      </div>

    </section>


    <!-- CONTACT -->

    <section id="contact">

      <div class="container">

        <div
          class="section-number"
          style="margin-bottom: 34px;"
        >
          {t.contact.label}
        </div>


        <h2 class="contact-title">
          {t.contact.title}
        </h2>


        <div class="contact-links">

          <!-- LINKEDIN -->

          <a
            href="https://www.linkedin.com/in/ardacolaker"
            target="_blank"
            rel="noopener noreferrer"
            class="icon-button"
            aria-label="LinkedIn"
            title="LinkedIn"
          >

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3A2.03 2.03 0 0 0 3.2 5.03c0 1.1.9 2.02 2.02 2.02h.03a2.03 2.03 0 1 0 0-4.05ZM20.44 12.44c0-3.44-1.84-5.04-4.3-5.04-1.98 0-2.87 1.09-3.37 1.86V8.5H9.39c.04.5 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.89-1.38 1.93-1.38 1.36 0 1.9 1.04 1.9 2.57V20H20.1v-6.56Z"
              />
            </svg>

          </a>


          <!-- GITHUB -->

          <a
            href="https://github.com/acolakera"
            target="_blank"
            rel="noopener noreferrer"
            class="icon-button"
            aria-label="GitHub"
            title="GitHub"
          >

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M12 .7C5.7.7.6 5.8.6 12.1c0 5 3.3 9.3 7.8 10.8.6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2.9-.3 1.9-.4 2.9-.4s2 .1 2.9.4C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.1v3.2c0 .3.2.7.8.6 4.5-1.5 7.8-5.8 7.8-10.8C23.4 5.8 18.3.7 12 .7Z"
              />
            </svg>

          </a>

        </div>

      </div>

    </section>


  </main>


  <!-- FOOTER -->

  <footer>

    <div class="container footer-content">

      <span>
        © 2026 Arda Colaker
      </span>


      <div class="footer-right">

        <a href="#main">
          {t.footer.top}
        </a>

        <span>
          ardacolaker.com
        </span>

      </div>

    </div>

  </footer>


</body>

</html>
